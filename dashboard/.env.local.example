# Dashboard env (Vercel: set these as Project Environment Variables).
# Data access is server-side only with the service role key — never exposed
# to the browser. The anon key is optional (not required by the current pages).
SUPABASE_URL="https://YOUR_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Protects the API routes / dashboard from public access. Set a long random
# string; the dashboard sends it as a header. (Simple gate; swap for real auth
# / Supabase Auth before exposing publicly.)
DASHBOARD_SECRET="YOUR_LONG_RANDOM_STRING"
