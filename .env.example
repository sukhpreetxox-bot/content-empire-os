# ============================================================================
# Content Empire OS  --  environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Each line notes WHERE you get the value.
# ============================================================================

# --- Supabase (Project Settings > Database > Connection string > URI) --------
SUPABASE_DB_URL="postgresql://postgres.[ref]:YOUR_PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres"
# Project Settings > API
SUPABASE_URL="https://YOUR_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"   # server-side only, keep secret

# --- LLM: Gemini primary → Groq → Ollama -------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_KEY"      # aistudio.google.com/apikey (free, no card)
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY="YOUR_GROQ_KEY"          # console.groq.com  (free tier, fast fallback)
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# --- Visuals: Pexels (fallback) + Pollinations AI images (primary) -----------
PEXELS_API_KEY="YOUR_PEXELS_KEY"      # pexels.com/api
POLLINATIONS_TOKEN="YOUR_POLLINATIONS_TOKEN"  # free at enter.pollinations.ai (AI images/video)
POLLINATIONS_MODEL="flux"

# --- YouTube Data API v3 -----------------------------------------------------
# One Google Cloud project + OAuth client PER YouTube channel (5 total).
# Store the OAuth client JSON files in secrets/ and reference per-channel
# tokens in the channels table (oauth_token_ref).
YOUTUBE_OAUTH_DIR="./secrets/youtube"

# --- Instagram Graph API -----------------------------------------------------
# Business/Creator accounts linked to a Facebook Page + Meta app.
IG_APP_ID="YOUR_META_APP_ID"
IG_APP_SECRET="YOUR_META_APP_SECRET"
IG_TOKEN_DIR="./secrets/instagram"

# --- Paths on the Oracle VM --------------------------------------------------
ASSETS_DIR="./assets"
REMOTION_DIR="./remotion"
